{
  "name": "netcloud-music",
  "productName": "NetCloud Music",
  "version": "0.1.0",
  "description": "Linux desktop shell for the NetEase Cloud Music web player",
  "main": "src/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "./tools/dev-run.sh --dev",
    "probe": "NETCLOUD_VERBOSE=1 ./tools/dev-run.sh --dev --probe",
    "dist": "electron-builder --linux",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:pacman": "electron-builder --linux pacman",
    "dist:deb": "electron-builder --linux deb",
    "dist:rpm": "electron-builder --linux rpm"
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "author": {
    "name": "netcloud-music contributors",
    "email": "lxp731@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lxp731/NetCloudMusic-Webplayer"
  },
  "homepage": "https://github.com/lxp731/NetCloudMusic-Webplayer",
  "desktopName": "netcloud-music.desktop"
}

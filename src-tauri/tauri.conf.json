{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netcloud-music",
  "version": "0.1.0",
  "identifier": "io.github.lxp731.netcloudmusic",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "AudioVideo",
    "shortDescription": "网易云音乐网页版的 Linux 桌面外壳",
    "longDescription": "网易云音乐网页版（music.163.com/st/webplayer）的非官方 Linux 桌面外壳，提供系统托盘、MPRIS 与媒体键等桌面集成。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
